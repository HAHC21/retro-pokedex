# Google Analytics — leave unset for local dev (gtag will not load).
# Set only for production builds, e.g. on the DigitalOcean static site component:
# VITE_GA_MEASUREMENT_ID=G-H9DLB7GLB9
# Optional UI release id (BUILD_TIME). When unset, each production build
# appends its own id to the newest changelog version so open tabs reload.
# VITE_APP_VERSION=
