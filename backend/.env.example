SECRET_KEY=replace-with-a-long-random-string
# Optional API release id. Open tabs reload when it changes.
# On App Platform set APP_VERSION to ${_self.COMMIT_HASH}.
# APP_VERSION=
FRONTEND_ORIGIN=http://localhost:5173
AUTH_REDIRECT_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MONGODB_URI=
# Email: console (log + show link) | resend | smtp
EMAIL_DELIVERY=resend
EMAIL_FROM=Pokédex <noreply@retropokedex.com>
# Optional STARTTLS relay. Unused when EMAIL_DELIVERY=resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=
# Gemini key from https://aistudio.google.com/apikey — enables AI movesets + overview script.
GEMINI_API_KEY=
# Prefer Flash-Lite (default gemini-3.5-flash-lite). Fallbacks include 3.6 Flash / Lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated emails elevated to admin/developer on login (never auto-demotes).
ADMIN_EMAILS=
DEVELOPER_EMAILS=
# Admin dashboard acquisition. Paste the service-account key as one JSON line, or a file path.
# Invite that account email on GA4 (Viewer), Search Console (user), and Google Ads (read-only).
# GOOGLE_ANALYTICS_PROPERTY_ID is the numeric property id, not the G- measurement id.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
# Celery worker only. The API does not connect to Redis.
CELERY_BROKER_URL=redis://redis:6379/0
FILL_GAPS_INTERVAL_SECONDS=900
