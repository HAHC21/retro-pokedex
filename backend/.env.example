SECRET_KEY=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
AUTH_REDIRECT_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MONGODB_URI=
# Email: console (log + show link) | smtp / mailersend | resend
EMAIL_DELIVERY=console
EMAIL_FROM=Pokédex <noreply@your-verified-domain.example>
# MailerSend SMTP (or any STARTTLS SMTP relay)
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=
# Gemini key from https://aistudio.google.com/apikey — enables AI movesets + overview script.
GEMINI_API_KEY=
# Prefer Flash-Lite (default gemini-3.5-flash-lite). Fallbacks include 3.6 Flash / Lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated emails elevated to admin/developer on login (never auto-demotes).
ADMIN_EMAILS=
DEVELOPER_EMAILS=
